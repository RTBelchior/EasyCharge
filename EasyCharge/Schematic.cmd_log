xst -intstyle ise -ifn "/home/ise/Documents/Projeto PCE/EasyCharge/Schematic.xst" -ofn "/home/ise/Documents/Projeto PCE/EasyCharge/Schematic.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -i -p xc3s100e-cp132-4 "Schematic.ngc" Schematic.ngd  
map -intstyle ise -p xc3s100e-cp132-4 -cm area -ir off -pr off -c 100 -o Schematic_map.ncd Schematic.ngd Schematic.pcf 
par -w -intstyle ise -ol high -t 1 Schematic_map.ncd Schematic.ncd Schematic.pcf 
trce -intstyle ise -v 3 -s 4 -n 3 -fastpaths -xml Schematic.twx Schematic.ncd -o Schematic.twr Schematic.pcf 
bitgen -intstyle ise -f Schematic.ut Schematic.ncd 
