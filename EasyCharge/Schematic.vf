//Command: sch2hdl -intstyle ise -family spartan3e -verilog "/home/ise/Documents/Projeto PCE/EasyCharge/Schematic.vf" -w "/home/ise/Documents/Projeto PCE/EasyCharge/Schematic.sch"
//Design Name: Schematic
//Device: spartan3e
//Purpose:
//    This verilog netlist is translated from an ECS schematic.It can be 
//    synthesized and simulated, but it should not be modified. 
//
`timescale 1ns / 1ps

module Schematic(buttonReset, 
                 clock, 
                 pModReset, 
                 switches, 
                 AN, 
                 LED0, 
                 LED1, 
                 LED2, 
                 LED3, 
                 SEG, 
                 SPOT0, 
                 SPOT1, 
                 SPOT2, 
                 SPOT3, 
                 SYNC);

    input buttonReset;
    input clock;
    input pModReset;
    input [3:0] switches;
   output [3:0] AN;
   output LED0;
   output LED1;
   output LED2;
   output LED3;
   output [6:0] SEG;
   output SPOT0;
   output SPOT1;
   output SPOT2;
   output SPOT3;
   output SYNC;
   
   wire clk_5sec;
   wire [15:0] counters;
   wire [1:0] Reset;
   
   clkDivider  XLXI_1 (.clk_50MHz(clock), 
                      .reset(Reset[1:0]), 
                      .clk_5sec(clk_5sec));
   counter  XLXI_2 (.clock(clock), 
                   .enable(switches[0]), 
                   .reset(Reset[1:0]), 
                   .counters(counters[3:0]));
   displaySeg  XLXI_3 (.clock(clock), 
                      .counters(counters[15:0]), 
                      .anodes(AN[3:0]), 
                      .segments(SEG[6:0]));
   counter  XLXI_4 (.clock(clock), 
                   .enable(switches[1]), 
                   .reset(Reset[1:0]), 
                   .counters(counters[7:4]));
   counter  XLXI_5 (.clock(clock), 
                   .enable(switches[2]), 
                   .reset(Reset[1:0]), 
                   .counters(counters[11:8]));
   counter  XLXI_6 (.clock(clock), 
                   .enable(switches[3]), 
                   .reset(Reset[1:0]), 
                   .counters(counters[15:12]));
   BUF  XLXI_7 (.I(switches[0]), 
               .O(LED0));
   BUF  XLXI_8 (.I(switches[1]), 
               .O(LED1));
   BUF  XLXI_9 (.I(switches[2]), 
               .O(LED2));
   BUF  XLXI_10 (.I(switches[3]), 
                .O(LED3));
   BUF  XLXI_12 (.I(clk_5sec), 
                .O(SYNC));
   BUF  XLXI_13 (.I(switches[0]), 
                .O(SPOT0));
   BUF  XLXI_14 (.I(switches[1]), 
                .O(SPOT1));
   BUF  XLXI_15 (.I(switches[2]), 
                .O(SPOT2));
   BUF  XLXI_16 (.I(switches[3]), 
                .O(SPOT3));
   BUF  XLXI_17 (.I(pModReset), 
                .O(Reset[0]));
   BUF  XLXI_18 (.I(buttonReset), 
                .O(Reset[1]));
endmodule
